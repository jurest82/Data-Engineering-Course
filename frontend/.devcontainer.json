{
  "name": "data-eng-course-frontend",
  "dockerComposeFile": ".docker/docker-compose.yml",
  "service": "data_eng_course_frontend",
  "workspaceFolder": "/app/frontend",
  "customizations": {
    "vscode": {
      "extensions": [
        "aaron-bond.better-comments",
        "davidanson.vscode-markdownlint",
        "esbenp.prettier-vscode",
        "irongeek.vscode-env",
        "mikestead.dotenv",
        "ms-azuretools.vscode-docker",
        "ms-vscode.live-server",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-spanish",
        "ty4z2008.html-preview",
        "threadheap.serverless-ide-vscode",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "cSpell.files": ["**/*.md", "**/*.js"],
        "cSpell.language": "en,es",
        "cSpell.words": ["Dockerized", "monorepository"],
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "git.autoRepositoryDetection": true,
        "git.openRepositoryInParentFolders": "always",
        "json.format.enable": true,
        "[markdown]": {
          "editor.formatOnSave": true,
          "editor.formatOnPaste": true,
          "editor.defaultFormatter": "davidanson.vscode-markdownlint"
        },
        "serverlessIDE.cfnLint.path": "/usr/local/bin/cfn-lint",
        "serverlessIDE.cfnLint.appendRules": ["cfn_lint_serverless.rules"],
        "serverlessIDE.completion": true,
        "serverlessIDE.hover": true,
        "serverlessIDE.telemetry.enableTelemetry": false,
        "serverlessIDE.validate": true,
        "serverlessIDE.validationProvider": "cfn-lint",
        "todo-tree.highlights.useColourScheme": true
      }
    }
  },
  "postCreateCommand": "sed -i 's/\\r$//' .docker/entrypoint.sh && sudo chmod +x .docker/entrypoint.sh && .docker/entrypoint.sh"
}
